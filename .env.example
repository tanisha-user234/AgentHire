# Environment Variables

# Backend
NODE_ENV=development
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_chars

# Free LLM - Groq (get free key at https://console.groq.com)
# Supports: llama-3.3-70b-versatile, mixtral-8x7b-32768, llama3-8b-8192
GROQ_API_KEY=your_groq_api_key_here

# If no GROQ_API_KEY is set, the system uses intelligent mock responses

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000
